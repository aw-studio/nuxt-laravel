{
    "name": "@aw-studio/nuxt-laravel",
    "version": "1.0.0",
    "description": "Sanctum auth, a typed HTTP client, filterable model indexes and Zod-validated forms for consuming a Laravel API from Nuxt 3 or 4.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aw-studio/nuxt-laravel.git"
    },
    "license": "MIT",
    "type": "module",
    "author": "Jannes Behrens",
    "exports": {
        ".": {
            "types": "./dist/types.d.mts",
            "import": "./dist/module.mjs"
        }
    },
    "main": "./dist/module.mjs",
    "typesVersions": {
        "*": {
            ".": [
                "./dist/types.d.mts"
            ]
        }
    },
    "files": [
        "dist",
        "CHANGELOG.md",
        "UPGRADE.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "prepack": "nuxt-module-build build",
        "dev": "npm run dev:prepare && nuxi dev playground",
        "dev:build": "nuxi build playground",
        "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
        "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@nuxt/kit": "^3.17.5 || ^4.0.0",
        "@vee-validate/zod": "^4.15.1",
        "defu": "^6.1.7",
        "vee-validate": "^4.15.1"
    },
    "devDependencies": {
        "@nuxt/devtools": "^3.4.1",
        "@nuxt/eslint-config": "^1.17.0",
        "@nuxt/module-builder": "^1.0.3",
        "@nuxt/test-utils": "^4.1.0",
        "@types/node": "latest",
        "@vitest/coverage-v8": "^4.1.11",
        "changelogen": "^0.6.2",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.5",
        "happy-dom": "^20.11.6",
        "nuxt": "^4.5.2",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11",
        "vue-tsc": "^3.3.10",
        "zod": "^4.4.3"
    },
    "peerDependencies": {
        "zod": "^3.24.0 || ^4.0.0"
    },
    "overrides": {
        "@vee-validate/zod": {
            "zod": "$zod"
        }
    },
    "keywords": [
        "nuxt",
        "nuxt-module",
        "laravel",
        "sanctum",
        "api",
        "zod",
        "vee-validate",
        "crud",
        "pagination",
        "filtering"
    ],
    "homepage": "https://github.com/aw-studio/nuxt-laravel",
    "bugs": {
        "url": "https://github.com/aw-studio/nuxt-laravel/issues"
    }
}
